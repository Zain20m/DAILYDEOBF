DISCORD_TOKEN=put_your_bot_token_here

# Optional: enables external Oracle conversion of IronBrew 2 bytecode into Lua source.
# When set, recovered bytecode is sent to oracle.mshq.dev.
IRONBREW2_ORACLE_KEY=

# Optional: set to 1 on a small bot host (roughly under 1 GB RAM). The Luraph
# v15.1 engine then runs one Python lifter instead of racing three, which cuts
# its peak memory to about a third. Inputs over 512 KB always use one.
DEOB_LOW_MEMORY=
